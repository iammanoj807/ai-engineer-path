# Optional: Google sign-in, so progress follows a learner across devices.
# Copy to .env.local for local development. Leave empty and the site still
# works, keeping progress in each browser. These values are not secret: they
# end up in the built JavaScript, and firestore.rules is what protects data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
